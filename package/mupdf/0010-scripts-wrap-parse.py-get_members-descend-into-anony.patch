From b5174269f72f5634b418a7c5216026d6bf2f4ccb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Rapha=C3=ABl=20M=C3=A9lotte?= <raphael.melotte@mind.be>
Date: Mon, 27 Jul 2026 12:44:16 +0200
Subject: [PATCH] scripts/wrap/parse.py: get_members(): descend into anonymous
 struct/union.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

fz_stext_block contains a field whose type is an anonymous union with
named nested-struct members, e.g.:

    union {
        struct { fz_stext_line *first_line, *last_line; int flags; } t;
        struct { fz_matrix transform; fz_image *image; } i;
        ...
    } u;

Under libclang from clang 22.1.3, calling get_children() on the FIELD_DECL
cursor for 'u' yields a single child that is the anonymous union's own
UNION_DECL cursor (with a synthesised .spelling like "(unnamed union at
fitz/structured-text.h:444:2)"), rather than yielding 'u's real members
('t', 'i', 's', 'v', 'b') directly. (The pre-existing, long-disabled
diagnostics code in this function already notes a related but different
symptom seen on older libclang: an extra empty-spelling child for the
same kind of anonymous union.)

This broke find_name()'s lookup of dotted paths like 'u.t.first_line',
which fz_stext_block's classextras.iterator_next relies on, causing
class_add_iterator() to fail with "Failed to find it_begin='u.t.first_line'
in struct_name='fz_stext_block'" (from the assert added in an earlier
commit).

When we see exactly one child and it is itself a STRUCT_DECL/UNION_DECL -
which does not happen for an ordinary named-type member, only for a field
whose type is defined anonymously inline - descend into that child to
find the real members.

Upstream: https://bugs.ghostscript.com/show_bug.cgi?id=709448
Signed-off-by: Raphaël Mélotte <raphael.melotte@mind.be>
---
 scripts/wrap/parse.py | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/scripts/wrap/parse.py b/scripts/wrap/parse.py
index 8881c68d0..b9a65ace2 100644
--- a/scripts/wrap/parse.py
+++ b/scripts/wrap/parse.py
@@ -162,8 +162,27 @@ def get_members( type_or_cursor, include_empty=False):
             for i in ret_type:
                 jlib.log( '    ret_type: {i}')
 
+    children = list(cursor2.get_children())
+    if (cursor2.kind == state.clang.cindex.CursorKind.FIELD_DECL
+            and len(children) == 1
+            and children[0].kind in (
+                state.clang.cindex.CursorKind.STRUCT_DECL,
+                state.clang.cindex.CursorKind.UNION_DECL,
+                )
+            ):
+        # <cursor2> is a field whose type is an anonymous struct/union
+        # defined inline (e.g. 'union { ... } u;'). A normal field with a
+        # named member type has no such child, so seeing exactly one
+        # STRUCT_DECL/UNION_DECL child here means some libclang versions are
+        # giving us the anonymous struct/union's own declaration cursor
+        # (with a synthesised, non-empty .spelling describing the anonymous
+        # type, e.g. '(unnamed union at ...)'), instead of directly giving
+        # us that struct/union's members. Descend into it to find the real
+        # members.
+        children = list(children[0].get_children())
+
     ret = list()
-    for cursor3 in cursor2.get_children():
+    for cursor3 in children:
         if include_empty or cursor3.spelling:
             ret.append(cursor3)
     if not ret:
-- 
