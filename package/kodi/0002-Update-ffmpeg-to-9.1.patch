-+    dst_##l[6 * i + 0] = r[Y];                      \
-+    dst_##l[6 * i + 1] = g[Y];                      \
-+    dst_##l[6 * i + 2] = b[Y];
-+
- #define PUTBGR24(l, i, abase)                       \
-     Y                  = py_##l[2 * i];             \
-     dst_##l[6 * i + 0] = b[Y];                      \
-@@ -98,12 +108,22 @@ const int *sws_getCoefficients(int colorspace)
-     dst_##l[6 * i + 4] = g[Y];                      \
-     dst_##l[6 * i + 5] = r[Y];
- 
-+#define PUTBGR24_ODD(l, i, abase)                   \
-+    Y                  = py_##l[2 * i];             \
-+    dst_##l[6 * i + 0] = b[Y];                      \
-+    dst_##l[6 * i + 1] = g[Y];                      \
